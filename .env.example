# Copy to .env (git-ignored) and fill in only the provider you use. Plain KEY=value lines: no quotes, no spaces
# around "=". Every app here reads this one file (its docker-compose.yml points at ../.env). When TruAssure's scripts
# start the apps, they pass TruAssure's own .env instead (SUT_ENV_FILE), so one file serves both repositories.

# ============================================================================ which LLM the demo apps use
# ANTHROPIC | AZURE | OPENAI | OLLAMA | OPENAI_COMPATIBLE | BEDROCK | GEMINI | VERTEX | SCRIPTED
# (aliases: CLAUDE, AZURE_OPENAI, LOCAL, VLLM, LMSTUDIO, GROQ, MISTRAL, TOGETHER, AWS, GOOGLE, GCP, OFFLINE)
DEFAULT_LLM_PROVIDER=AZURE

# Optional per-app overrides (win over DEFAULT_LLM_PROVIDER for that app only)
# CHAT_LLM_PROVIDER=
# CLAIMS_LLM_PROVIDER=
# DESK_LLM_PROVIDER=

# Optional, any provider: override the model/deployment, and a sampling temperature where the provider accepts it
# LLM_MODEL=
# LLM_TEMPERATURE=

# ---------------------------------------------------------------------------- AZURE (Azure OpenAI)
AZURE_API_KEY=
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DEPLOYMENT=gpt-4.1
AZURE_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_TEMPERATURE=0.1

# ---------------------------------------------------------------------------- ANTHROPIC (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback for the models that support it (1 = on). Set 0 if your account rejects it.
# ANTHROPIC_FALLBACKS=1

# ---------------------------------------------------------------------------- OPENAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------- OLLAMA (local models)
# From a container, Ollama on your machine is http://host.docker.internal:11434/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------- OPENAI_COMPATIBLE (vLLM, LM Studio, Groq, Mistral, Together, ...)
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# ---------------------------------------------------------------------------- BEDROCK (AWS, any Converse model)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Credentials: the standard AWS chain, e.g.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------- GEMINI (Google AI Studio key)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------- VERTEX (Gemini on Google Cloud; Application Default Credentials)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------- SCRIPTED (offline, deterministic; CI and demos without keys)
# LLM_SCRIPT=package.module:factory      (an app's built-in rule-based policy)
# LLM_SCRIPT_FILE=path/to/replay.jsonl   (replay recorded responses)

# ============================================================================ all LLM calls (every provider, every app)
# LLM_TIMEOUT=120        seconds per request
# LLM_MAX_RETRIES=2

# ============================================================================ demo apps' test-control tokens (empty = refuse)
# CHAT_SANDBOX_TOKEN=
# CLAIMS_SANDBOX_TOKEN=
# DESK_SANDBOX_TOKEN=

# ============================================================================ the chat assistant's demo users
# Required to run the chat assistant: the password of its demo customers and representatives (never in the code).
DEMO_USER_PASSWORD=

# ============================================================================ observed deployments (docker-compose.observed.yml)
# The TruAssure recording proxy's control token (fault injection); TruAssure's .env must hold the same value.
# TA_PROXY_TOKEN=
# The proxy image (TruAssure's scripts build truassure/proxy:dev from TruAssure's source before deploying).
# TRUASSURE_PROXY_IMAGE=truassure/proxy:dev

# ============================================================================ buggy builds (test runs only; see each app's README)
# CLAIMS_DEFECTS=
# DESK_DEFECTS=
